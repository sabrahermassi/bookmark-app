{
  "name": "bookmark-app",
  "version": "1.0.0",
  "private": true,
  "description": "A full-stack bookmarks manager built with React, TypeScript, Express and PostgreSQL, where users save, organize and search their links privately.",
  "keywords": [],
  "homepage": "https://github.com/sabrahermassi/bookmark-app#readme",
  "bugs": {
    "url": "https://github.com/sabrahermassi/bookmark-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabrahermassi/bookmark-app.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently \"tsc --noEmit --watch\" \"tsx watch --env-file=.env apps/api/src/index.ts\"",
    "typecheck": "tsc --noEmit",
    "start": "tsc && node --env-file=.env dist/index.js"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^26.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
