{
  "name": "bookmark-app",
  "version": "1.0.0",
  "private": true,
  "description": "A full-stack bookmarks manager built with React, TypeScript, Express and PostgreSQL, where users save, organize and search their links privately.",
  "keywords": [],
  "homepage": "https://github.com/sabrahermassi/bookmark-app#readme",
  "bugs": {
    "url": "https://github.com/sabrahermassi/bookmark-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabrahermassi/bookmark-app.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "concurrently \"tsc --noEmit --watch\" \"tsx watch --env-file=.env apps/api/src/index.ts\" \"vite apps/web\"",
    "typecheck": "tsc --noEmit && tsc -b apps/web",
    "start": "tsc && node --env-file=.env dist/index.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^26.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
